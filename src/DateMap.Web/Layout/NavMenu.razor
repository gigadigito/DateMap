@inject AuthService AuthService
@inject NavigationManager Navigation

<nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Date Map</a>
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-light">@context.User.Identity?.Name</span>
                    <button class="btn btn-outline-light btn-sm" @onclick="LogoutAsync">Logout</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<AuthorizeView>
    <Authorized>
        <nav class="sidebar bg-light border-end">
            <div class="p-3">
                <NavLink class="nav-link" href="/diaries" Match="NavLinkMatch.All">
                    <span>Diaries</span>
                </NavLink>
                <NavLink class="nav-link" href="/categories">
                    <span>Categories</span>
                </NavLink>
            </div>
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
