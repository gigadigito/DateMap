@inject AuthService AuthService
@inject NavigationManager Navigation

<header class="site-header">
    <a class="brand" href="/">Date <span>Map</span></a>
    <AuthorizeView>
        <Authorized>
            <div class="header-account"><span>@context.User.Identity?.Name</span><button class="btn btn-sm btn-outline-light" @onclick="LogoutAsync">Sair</button></div>
        </Authorized>
        <NotAuthorized><a class="btn btn-sm btn-outline-light" href="/login">Entrar</a></NotAuthorized>
    </AuthorizeView>
</header>

<AuthorizeView>
    <Authorized>
        <nav class="primary-nav" aria-label="Navegação principal">
            <NavLink href="/discover">Descobrir</NavLink>
            <NavLink href="/matches">Matches</NavLink>
            <NavLink href="/dates">Encontros</NavLink>
            <NavLink href="/map">Mapa</NavLink>
            <NavLink href="/profile">Perfil</NavLink>
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
