@page "/matches"
@attribute [Authorize]
@inject DatingService Dating

<div class="page-heading"><h1>Matches</h1><p>Conexões em que o interesse é recíproco.</p></div>
@if (loading) { <p>Carregando matches...</p> }
else if (error is not null) { <div class="error-message">@error</div> }
else if (cards.Count == 0) { <div class="empty-panel"><h2>Ainda não houve match</h2><p>Descubra pessoas e dê o primeiro passo.</p><a class="btn btn-primary" href="/discover">Descobrir pessoas</a></div> }
else
{
    <div class="profile-grid">
        @foreach (var card in cards)
        {
            <article class="dating-card">
                @if (card.Person.Photos.FirstOrDefault() is string photo) { <img class="profile-photo" src="@photo" alt="Foto de @card.Person.DisplayName" /> }
                else { <div class="photo-placeholder" aria-hidden="true">♥</div> }
                <h2 class="mt-3">@card.Person.DisplayName</h2><p>@card.Person.City</p>
                <small class="text-muted">Match em @card.Match.MatchedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                <div class="d-flex flex-wrap gap-2 mt-3"><a class="btn btn-outline-primary" href="/profiles/@card.Person.Id">Ver perfil</a><a class="btn btn-primary" href="/dates/new?matchId=@card.Match.Id">Marcar encontro</a></div>
            </article>
        }
    </div>
    <p class="text-muted mt-3">Mensagens: em breve.</p>
}

@code {
    private List<(MatchDto Match, ProfileDto Person)> cards = [];
    private bool loading = true;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var me = await Dating.MyProfile();
            if (me is null) throw new InvalidOperationException();
            foreach (var match in await Dating.Matches() ?? [])
            {
                if (match.Status != 0) continue;
                var other = match.ProfileAId == me.Id ? match.ProfileBId : match.ProfileAId;
                var person = await Dating.Profile(other);
                if (person is not null) cards.Add((match, person));
            }
        }
        catch { error = "Não foi possível carregar os matches. Tente novamente."; }
        finally { loading = false; }
    }
}
