@page "/diaries/new"
@attribute [Authorize]
@inject DiaryService DiaryService
@inject NavigationManager Navigation

<h1>Nova memória</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="error-message">@error</div>
}

<EditForm Model="model" OnValidSubmit="HandleCreate" FormName="newDiary">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Título</label>
        <InputText class="form-control" @bind-Value="model.Title" />
        <ValidationMessage For="() => model.Title" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <InputTextArea class="form-control" @bind-Value="model.Description" rows="3" />
        <ValidationMessage For="() => model.Description" />
    </div>

    <div class="mb-3">
        <label class="form-label">Link da imagem de capa</label>
        <InputText class="form-control" @bind-Value="model.CoverImageUrl" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@loading">
        @(loading ? "Criando..." : "Criar memória")
    </button>
    <a href="/diaries" class="btn btn-secondary">Cancelar</a>
</EditForm>

@code {
    private CreateDiaryModel model = new();
    private string? error;
    private bool loading;

    private async Task HandleCreate()
    {
        error = null;
        loading = true;
        try
        {
            var diary = await DiaryService.CreateAsync(new CreateDiaryRequest(model.Title, model.Description, model.CoverImageUrl));
            Navigation.NavigateTo($"/diaries/{diary.Id}");
        }
        catch
        {
            error = "Não foi possível criar a memória. Confira os campos.";
        }
        finally
        {
            loading = false;
        }
    }

    private class CreateDiaryModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(150)]
        public string Title { get; set; } = "";

        [System.ComponentModel.DataAnnotations.MaxLength(2000)]
        public string? Description { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(2048)]
        public string? CoverImageUrl { get; set; }
    }
}
